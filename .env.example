# LLM provider: gemini or grok
LLM_PROVIDER=gemini

# Get your API key from: https://aistudio.google.com/app/apikey
# Use a key starting with AIza... (NOT AQ.Ab... OAuth tokens)
GEMINI_API_KEY=your_api_key_here

# Model name
GEMINI_MODEL=gemini-3.8-flash

# Grok (xAI) settings - get key from https://console.x.ai
XAI_API_KEY=your_xai_key_here
GROK_MODEL=grok-4.7

# Groq settings - FREE key from https://console.groq.com
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Set to true to enable question suggestions after upload (uses extra API calls)
ENABLE_SUGGESTIONS=false

# Token-saving caps (lower = cheaper/faster)
MAX_HISTORY_TURNS=2
RETRIEVAL_K=3
MAX_CHUNK_CHARS=350
MAX_OUTPUT_TOKENS=400
SUGGESTION_CHUNKS=3
SUGGESTION_CTX_CHARS=1200
